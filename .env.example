# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=

# Scanner
MAX_WORKERS=8
BATCH_SIZE=1000
CACHE_DIR=~/.image_organizer

# Safety
BACKUP_DIR=~/.image_organizer_backup
BACKUP_RETENTION_DAYS=30

# GUI (optional)
# QT_SCALE_FACTOR=1.0
